#!/bin/sh
# Configuración central de NovaLinux Zenkai OS (Debian 13 Trixie).
set -eu

lb config noauto \
  --mode debian \
  --distribution trixie \
  --architectures amd64 \
  --linux-flavours amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --binary-images iso-hybrid \
  --firmware-chroot true \
  --firmware-binary true \
  --apt-recommends true \
  --bootappend-live "boot=live components locales=es_ES.UTF-8 keyboard-layouts=es username=admin" \
  --debian-installer live \
  --iso-application "NovaLinux Zenkai OS" \
  --iso-publisher "NovaLinux Zenkai OS Project" \
  --iso-volume "NOVALINUX_ZENKAI" \
  "$@"
